# Server-only canonical backend URL. Never expose this value through NEXT_PUBLIC_*.
# Must include /api/v1 to match the dashboard API contract.
BACKEND_API_URL=https://api.baraqapp.com/api/v1/
BACKEND_API_TIMEOUT_MS=15000
# Must remain above the largest supported upload (25MB) to allow multipart overhead.
BFF_MAX_BODY_BYTES=31457280
# Live binding requires BOTH flags true (and API_BINDING_FORCE_PAUSED=false).
# NEXT_PUBLIC_* is baked at build time — required for Docker/browser.
# When disabled: login/BFF/session refuse access (no offline superuser).
API_BINDING_ENABLED=true
NEXT_PUBLIC_API_BINDING_ENABLED=true

# Public dashboard metadata.
NEXT_PUBLIC_APP_NAME=لوحة تحكم برّاق
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Origin of the student application. Invitation links point at its
# /join page; when unset, the dashboard offers the code only rather
# than a link to a host it does not serve.
NEXT_PUBLIC_STUDENT_WEB_URL=
NEXT_PUBLIC_DASHBOARD_VERSION=1.0.0

# Cookie hardening. Keep true in production over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=

# Optional deployment metadata.
DEPLOYMENT_ENVIRONMENT=production
