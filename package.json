    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "9.28.0",
    "eslint-config-next": "15.4.6",
    "typescript": "5.8.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.28"
